{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": [
      "src"
    ]
  },
  "staticAnalysisTool": "phpstan",
  "staticAnalysisToolOptions": "--level=8 src tests",
  "logs": {
    "text": "tmp/infection.log"
  },
  "mutators": {
    "@default": false,
    "PHPStan\\Infection\\TrinaryLogicMutator": true
  }
}
